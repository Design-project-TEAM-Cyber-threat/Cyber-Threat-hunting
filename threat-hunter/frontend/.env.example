# Optional. Leave unset to use the Vite proxy ("/api" -> http://127.0.0.1:8000).
# Set this only if the API lives somewhere else (Django then needs CORS enabled for this origin):
# VITE_API_BASE_URL=http://127.0.0.1:8000/api
# Optional: where the dev-server proxy forwards "/api":
# VITE_BACKEND_URL=http://127.0.0.1:8000
